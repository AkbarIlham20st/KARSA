  m_Name: Data_Babirusa
  m_EditorClassIdentifier: Assembly-CSharp::DataHewan
  namaHewan: Babi Rusa (Babyrousa)
  tinggi: 65 - 80 cm
  berat: 90 kg
  habitat: Hutan Hujan Tropis
  asal: Sulawesi dan Maluku
  makanan: buah-buahan, umbi-umbian, daun, jamur, serta serangga
  deskripsi: Babi rusa adalah marga binatang yang termasuk kerabat babi liar. Hewan
    ini memiliki taring panjang yang mencuat dan melengkung di atas moncongnya. Babi
    rusa hidup berkelompok di daerah rawa-rawa dan semak-semak. Mereka aktif mencari
    makan pada malam hari dan beristirahat pada siang hari.
  suaraHewan: {fileID: 8300000, guid: b4a372247af939242997be29e83e13b0, type: 3}
