  m_Script: {fileID: 11500000, guid: 8952074275bbabf4eb999a6de32a5495, type: 3}
  m_Name: Data_Beruang
  m_EditorClassIdentifier: Assembly-CSharp::DataHewan
  namaHewan: 'Beruang '
  tinggi: 2,4 - 3,5 m
  berat: 50 - 116 kg
  habitat: Pulau Bersalju & Hujan Tropis
  asal: Amerika Utara, Amerika Selatan, Eurasia, hingga Asia Tenggara
  makanan: Buah-buahan, beri, akar-akaran, tunas muda, kacang-kacangan, serangga
    (terutama semut dan larva), madu, ikan, serta mamalia kecil.
  deskripsi: Beruang adalah mamalia berbadan besar, berbulu lebat, dan memiliki cakar
    yang kuat. Mereka memiliki indra penciuman yang sangat tajam dan dikenal sebagai
    pemakan segala (omnivora), yang berarti mereka suka memakan daging, madu, ikan,
    hingga buah-buahan.
  suaraHewan: {fileID: 8300000, guid: 9b39dded36161774682917c22da5e539, type: 3}
