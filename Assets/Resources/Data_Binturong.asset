  m_Name: Data_Binturong
  m_EditorClassIdentifier: Assembly-CSharp::DataHewan
  namaHewan: Binturung atau Binturong
  tinggi: 34 - 54 cm
  berat: 11 - 32 kg
  habitat: Hutan Hujan Tropis
  asal: Sumatra, Jawa, Kalimantan
  makanan: Omnivora (umbi, buah, serangga)
  deskripsi: Binturung atau Binturong adalah sejenis musang bertubuh besar, anggota
    famili Viverridae. Beberapa dialek Melayu menyebutnya binturong, menturung atau
    menturun. Dalam bahasa Inggris, hewan ini disebut Binturong, Malay Civet Cat,
    Asian Bearcat, Palawan Bearcat, atau secara ringkas Bearcat.
  suaraHewan: {fileID: 8300000, guid: bebe771d51c4c6f489ea87abeb3ca8a6, type: 3}
