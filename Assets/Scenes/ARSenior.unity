  m_Script: {fileID: 11500000, guid: e396fe373fc63974195bb66e03404520, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KuisManager
  daftarSoal:
  - soal: "Mamalia adalah kelompok hewan yang\u2026"
    pilihanJawaban:
    - a. Bertelur dan bersisik
    - b. Menyusui anaknya dan berdarah panas
    - c. Bertulang lunak dan hidup di air
    - d. Bisa terbang dan punya paruh
    indeksJawabanBenar: 1
  - soal: "Contoh mamalia yang hidup di air adalah\u2026"
    pilihanJawaban:
    - 'a. Hiu '
    - 'b. Lumba-lumba '
    - 'c. Gurita '
    - 'd. Ikan pari '
    indeksJawabanBenar: 1
  - soal: "Fungsi belalai gajah adalah\u2026"
    pilihanJawaban:
    - 'a. Menyerang '
    - 'b. Menangkap mangsa '
    - 'c. Mengambil makanan dan minum '
    - 'd. Terbang '
    indeksJawabanBenar: 2
  - soal: 'Hewan berikut ini bukan termasuk mamalia: '
    pilihanJawaban:
    - 'a. Harimau '
    - 'b. Elang '
    - 'c. Gajah '
    - 'd. Orangutan '
    indeksJawabanBenar: 1
  - soal: "Mamalia yang memiliki punuk dan hidup di gurun adalah\u2026"
    pilihanJawaban:
    - 'a. Kuda nil '
    - 'b. Unta '
    - 'c. Rusa '
    - 'd. Kuda '
    indeksJawabanBenar: 1
  - soal: Apa ciri utama jerapah?
    pilihanJawaban:
    - 'a. Punya gigi tajam dan bersayap '
    - 'b. Leher panjang dan makan daun '
    - 'c. Kulit sisik dan bisa berenang '
    - 'd. Bertelur di darat '
    indeksJawabanBenar: 1
  - soal: "Mamalia yang dikenal sebagai pemangsa buas dan hidup sendiri adalah\u2026"
    pilihanJawaban:
    - 'a. Singa '
    - 'b. Kucing '
    - 'c. Harimau '
    - 'd. Rusa '
    indeksJawabanBenar: 2
  - soal: "Orangutan termasuk mamalia yang hidup di\u2026"
    pilihanJawaban:
    - 'a. Air laut '
    - 'b. Tanah berbatu '
    - 'c. Pohon hutan hujan tropis '
    - 'd. Gurun '
    indeksJawabanBenar: 2
  - soal: "Mamalia menyusui anaknya dengan\u2026"
    pilihanJawaban:
    - a. Paruh
    - b. Kelenjar susu
    - 'c. Sirip '
    - d. Cakar
    indeksJawabanBenar: 1
  - soal: "Satwa mamalia dilindungi karena\u2026"
    pilihanJawaban:
    - 'a. Bisa dimakan '
    - 'b. Jumlahnya terbatas dan terancam punah '
    - 'c. Menyebabkan hama '
    - 'd. Tidak memiliki predator '
    indeksJawabanBenar: 1
  - soal: "Fungsi suara dalam aplikasi KARSA adalah\u2026"
    pilihanJawaban:
    - 'a. Musik hiburan '
    - 'b. Penanda waktu '
    - 'c. Mengetahui suara tentang hewan '
    - 'd. Alarm '
    indeksJawabanBenar: 2
  - soal: 'Contoh mamalia yang hidup di kebun binatang dan berasal dari Indonesia:'
    pilihanJawaban:
    - a. Unta
    - b. Orangutan
    - c. Beruang kutub
    - d. Zebra
    indeksJawabanBenar: 1
  - soal: 'Mamalia yang bisa hidup di air dan menyusui di laut:'
    pilihanJawaban:
    - a. Lumba-lumba dan paus
    - b. Kura-kura dan anjing laut
    - c. Katak dan buaya
    - d. Ikan dan belut
    indeksJawabanBenar: 0
  - soal: "Kuda nil lebih banyak hidup di\u2026"
    pilihanJawaban:
    - a. Laut lepas
    - b. Sungai dan danau
    - c. Padang pasir
    - d. Hutan salju
    indeksJawabanBenar: 1
  - soal: "Paus dan lumba-lumba bernapas melalui\u2026"
    pilihanJawaban:
    - a. Insang
    - b. Paru-paru
    - c. Kulit
    - d. Rongga air
    indeksJawabanBenar: 0
  - soal: "Mamalia pemakan tumbuhan disebut\u2026"
    pilihanJawaban:
    - a. Karnivora
    - b. Omnivora
    - c. Herbivora
    - d. Insektivora
    indeksJawabanBenar: 0
  - soal: "Mamalia bertubuh besar, memiliki taring, dan suka berburu disebut\u2026"
    pilihanJawaban:
    - a. Pemakan rumput
    - b. Predator
    - c. Nokturnal
    - d. Menyusui
    indeksJawabanBenar: 1
  - soal: "Yang termasuk ciri umum mamalia adalah\u2026"
    pilihanJawaban:
    - a. Tidak punya tulang belakang
    - b. Kulit bersisik
    - c. Bertulang belakang dan berbulu
    - d. Bisa bertelur
    indeksJawabanBenar: 2
  - soal: "Mamalia aktif di malam hari disebut\u2026"
    pilihanJawaban:
    - a. Nokturnal
    - b. Diurnal
    - c. Herbivora
    - d. Soliter
    indeksJawabanBenar: 0
  - soal: "Tujuan aplikasi KARSA adalah\u2026"
    pilihanJawaban:
    - a. Bermain game
    - b. Belajar mengenal satwa mamalia dengan cara menyenangkan
    - c. Menjual hewan
    - d. Membuat video animasi
    indeksJawabanBenar: 1
